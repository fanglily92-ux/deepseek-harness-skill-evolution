{
  "name": "deepseek-harness-skill-evolution",
  "version": "0.1.0",
  "description": "A local, approval-gated Skill evolution workbench for DeepSeek Harness.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src/",
    "config/",
    "eval/",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test",
